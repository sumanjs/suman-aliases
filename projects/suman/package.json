{
  "name": "@suman/suman",
  "version": "1.1.51234",
  "description": "Suman scoped alias.",
  "main": "index.js",
  "scripts": {
    "test": "suman test",
    "lint:ores": "if [ -f ../../.ores-lint/lint.sh ]; then sh ../../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman-aliases.git"
  },
  "keywords": [
    "sumanjs",
    "suman",
    "testing",
    "test"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-aliases/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-aliases#readme",
  "dependencies": {
    "suman": "^1.1.51234"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
